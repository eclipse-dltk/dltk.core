Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: org.eclipse.dltk.formatter;singleton:=true
Bundle-Version: 6.4.2.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-11
Bundle-Vendor: %pluginProvider
Bundle-Localization: plugin
Export-Package: org.eclipse.dltk.formatter,
 org.eclipse.dltk.formatter.internal;x-friends:="org.eclipse.dltk.formatter.tests"
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.text,
 org.eclipse.ui.workbench,
 org.eclipse.dltk.core;bundle-version="0.0.0",
 org.eclipse.dltk.ui;bundle-version="0.0.0"
Bundle-Activator: org.eclipse.dltk.formatter.DLTKFormatterPlugin
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: org.eclipse.dltk.formatter
